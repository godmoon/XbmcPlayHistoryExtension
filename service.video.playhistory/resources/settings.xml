<?xml version="1.0" ?>
<settings version="1">
    <section id="service.video.playhistory">
        <category id="general" label="General">
            <group id="1">
                <setting id="max_history" type="integer" label="Max History" help="Maximum number of history entries to keep">
                    <level>0</level>
                    <default>100</default>
                    <constraints>
                        <minimum>10</minimum>
                        <maximum>1000</maximum>
                        <step>10</step>
                    </constraints>
                    <control type="spinner" format="integer"/>
                </setting>
                <setting id="track_video_only" type="boolean" label="Track Video Only" help="Only track video playback (ignore audio/pictures)">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle"/>
                </setting>
            </group>
        </category>
    </section>
</settings>
